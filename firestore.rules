rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if requesting user is a verified Admin in 'admins' collection
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Helper: Check if requesting user is a registered Doctor
    function isDoctor() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/doctors/$(request.auth.uid))
      );
    }

    // ----------------------------------------------------
    // ADMINS COLLECTION
    // ----------------------------------------------------
    match /admins/{adminId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == adminId;
      allow update, delete: if isAdmin();
    }

    // ----------------------------------------------------
    // USERS COLLECTION (Patient Profile & Health Details)
    // ----------------------------------------------------
    // - Authenticated users (patients, doctors, admins) can read user profiles and health details
    // - Users can write their own document; admins can update/delete
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ----------------------------------------------------
    // APPOINTMENTS COLLECTION
    // ----------------------------------------------------
    // - Authenticated patients can book appointments
    // - Authenticated doctors, patients, and admins can view and update appointments
    // - Allows queries by userId, doctorName, and admin full listing
    match /appointments/{appointmentId} {
      allow read, write: if request.auth != null;
    }

    // ----------------------------------------------------
    // DOCTORS COLLECTION
    // ----------------------------------------------------
    // - Allow reading doctor listings for patients and guests
    // - Authenticated doctors and admins can create/update
    // - Admins can delete
    match /doctors/{doctorId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if isAdmin();
    }
  }
}
